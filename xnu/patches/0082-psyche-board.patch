+/* Root compatible of the ADT (tools/mkadt.py --device psyche). */
+bool
+sweet_board_is_psyche(void)
+{
+	static int cached = -1;
+	DTEntry root;
+	char const *compat;
+	unsigned int size;
+
+	if (cached >= 0) {
+		return cached;
+	}
+	cached = 0;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (void const **)&compat, &size) != kSuccess) {
+		return false;
+	}
+	static const char want[] = "xiaomi,psyche";
+	for (unsigned int i = 0; i < size;) {
+		unsigned int n = 0;
+		while (i + n < size && compat[i + n] != '\0') {
+			n++;
+		}
+		if (n == sizeof(want) - 1 && memcmp(compat + i, want, n) == 0) {
+			cached = 1;
+			break;
+		}
+		i += n + 1;
+	}
+	return cached;
+}
